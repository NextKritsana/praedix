FROM kalilinux/kali-rolling

# Avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Core system tools (very stable, small)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git curl whois dnsutils traceroute \
    && rm -rf /var/lib/apt/lists/*

# Main scanners (separate layer - if this fails, core still works)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap dirb sslscan \
    && rm -rf /var/lib/apt/lists/*

# Heavy scanners with many deps (separate layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlmap \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: sqlmap install failed, skipping"

# Nikto (has problematic perl deps, isolated)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nikto \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: nikto install failed, skipping"

# Modern web recon / DAST tools used by the Web App Deep Scan profile.
# Kali packages are preferred because they build much faster than go install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates golang-go nuclei ffuf subfinder httpx-toolkit \
    && ln -sf /usr/bin/httpx-toolkit /usr/local/bin/httpx \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: modern web scanner package install failed, skipping optional tools"

ENV GOPATH=/root/go
ENV PATH="/root/go/bin:${PATH}"

RUN timeout 420s go install github.com/projectdiscovery/katana/cmd/katana@latest \
    && ln -sf /root/go/bin/katana /usr/local/bin/katana \
    || echo "WARNING: katana install failed or timed out, skipping optional crawler"

# Install lightweight Python tools via pip (avoids heavy Kali deps)
RUN pip3 install --break-system-packages \
    wafw00f \
    flask

# Clone hackingtool to allow the AI to explore its scripts
RUN git clone https://github.com/Z4nzu/hackingtool.git /opt/hackingtool

WORKDIR /opt/hackingtool

# Python wrapper to expose tools to the AI Agent
COPY hackingtool_wrapper.py .

# Run the API server
CMD ["python3", "hackingtool_wrapper.py"]
